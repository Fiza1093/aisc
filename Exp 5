import random

POP_SIZE = 6
CHROMOSOME_LENGTH = 5
GENERATIONS = 10
MUTATION_RATE = 0.1


def generate_chromosome():
    return ''.join(random.choice('01') for _ in range(CHROMOSOME_LENGTH))


def evaluate_fitness(chromosome):
    decimal_x = int(chromosome, 2)
    return decimal_x * decimal_x


def execute_mutation(chromosome):
    gene_list = list(chromosome)

    if random.random() < MUTATION_RATE:
        flip_idx = random.randint(0, CHROMOSOME_LENGTH - 1)
        gene_list[flip_idx] = '1' if gene_list[flip_idx] == '0' else '0'

    return ''.join(gene_list)


population = [generate_chromosome() for _ in range(POP_SIZE)]

for current_gen in range(GENERATIONS):
    population.sort(key=evaluate_fitness, reverse=True)

    print(f"\n--- Generation Step Vector Run: {current_gen + 1} ---")

    for individual in population:
        print(
            f"Chromosome Vector Sequence: {individual} | "
            f"Evaluated Fitness Score = {evaluate_fitness(individual)}"
        )

    parent_alpha = population[0]
    parent_beta = population[1]

    crossover_point = random.randint(1, CHROMOSOME_LENGTH - 2)

    offspring_alpha = parent_alpha[:crossover_point] + parent_beta[crossover_point:]
    offspring_beta = parent_beta[:crossover_point] + parent_alpha[crossover_point:]

    offspring_alpha = execute_mutation(offspring_alpha)
    offspring_beta = execute_mutation(offspring_beta)

    population[-1] = offspring_alpha
    population[-2] = offspring_beta


absolute_best_chromosome = max(population, key=evaluate_fitness)

print("\n================ FINAL OPTIMAL GENERATION OUTPUT ================")
print(f"Elite Target Chromosome Decoded : {absolute_best_chromosome}")
print(f"Decimal Vector Value (x Coordinate) : {int(absolute_best_chromosome, 2)}")
print(
    f"Calculated Maximum Global Fitness f(x): "
    f"{evaluate_fitness(absolute_best_chromosome)}"
)
print("================================================================")
